package wasmline:service@1.0.0;

world plugin {
  import host: interface {
    record request {
      action: string,
      codec: string,
      payload: list<u8>
    }

    record service-error {
      /// Decimal WasmlineErrorCode value, or a stable symbolic code for non-Wasmline guests.
      code: string,
      message: string,
      details: list<u8>
    }

    invoke: func(request: request) -> result<list<u8>, service-error>;
  }

  // Keep host and plugin roles nominally distinct so guest generators can emit
  // independent import and export bindings for the same structural protocol.
  export plugin: interface {
    record request {
      action: string,
      codec: string,
      payload: list<u8>
    }

    record service-error {
      /// Decimal WasmlineErrorCode value, or a stable symbolic code for non-Wasmline guests.
      code: string,
      message: string,
      details: list<u8>
    }

    invoke: func(request: request) -> result<list<u8>, service-error>;
  }
}
