#!/usr/bin/env python3
"""Wasmline repository command entry point."""

from __future__ import annotations

import sys
from pathlib import Path


SCRIPTS_ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPTS_ROOT / "lib" / "python"))

from wasmline_tools.cli import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main())
